# Copy to local.env (git-ignored) for settings that are yours alone.

# Your own bundle identifier. Keep using the one you've always built with, or macOS treats it as a new
# app: settings, Accessibility permission and launch-at-login are tied to it.
# INGLE_BUNDLE_ID=com.yourname.ingle

# Publisher name for your local build of the VS Code extension. Keep the old one if you've installed it
# before, so VS Code keeps your chat history.
# VSCODE_PUBLISHER=yourname

# Words that must never appear in a public release (names, paths, emails). Checked by scripts/export-release.sh.
# PRIVATE_WORDS="yourname|/Users/yourname|you@example.com"

# Where VS Code lives, if Extensions/vscode/install.sh can't find it (it checks PATH, /Applications,
# ~/Applications and Spotlight).
# VSCODE_APP="/Applications/Tools/Visual Studio Code.app"
